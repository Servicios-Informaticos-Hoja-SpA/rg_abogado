---
import { OFFICIAL_PHONE, buildUrgencyWhatsAppLink } from '../data/causes';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const urgencyWhatsAppUrl = buildUrgencyWhatsAppLink();
---

<div class={`bg-burdeo-900 border border-almendra/40 text-crema p-6 sm:p-8 relative overflow-hidden ${className}`}>
  <!-- Acento lateral sutil -->
  <div class="absolute top-0 left-0 bottom-0 w-1.5 bg-alerta"></div>

  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pl-2">
    <div class="space-y-2 lg:max-w-2xl">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-alerta animate-pulse"></span>
        <span class="text-[11px] font-mono tracking-widest text-almendra uppercase font-semibold">
          URGENCIA PENAL 24 HORAS
        </span>
      </div>
      <h3 class="font-serif text-xl sm:text-2xl text-crema font-normal">
        ¿Un familiar fue detenido en Santiago o la Región de Valparaíso?
      </h3>
      <p class="text-xs sm:text-sm text-crema/80 leading-relaxed">
        El control de detención ante el Juzgado de Garantía cuenta con un plazo fatal legal de máximo 24 horas. La asistencia letrada particular oportuna es clave para discutir la legalidad de la aprehensión y evitar medidas cautelares gravosas.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 flex-shrink-0">
      <a 
        href={`tel:${OFFICIAL_PHONE}`}
        class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-alerta hover:bg-alerta-hover text-crema text-xs font-bold uppercase tracking-wider transition-colors border border-crema/20"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="square" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Llamada de Urgencia</span>
      </a>
      <a 
        href={urgencyWhatsAppUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-crema hover:bg-almendra text-burdeo-900 text-xs font-bold uppercase tracking-wider transition-colors"
      >
        <span>WhatsApp de Urgencia</span>
        <svg class="w-4 h-4 text-burdeo-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="square" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</div>
